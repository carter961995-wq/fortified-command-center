NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_WORKSPACE_DOMAIN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional local folder for Google/mHelpDesk/job-intake JSON state (defaults to .fortified-data)
FORTIFIED_USER_DATA_DIR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mac desktop signing and Apple notarization.
# Keep real values in .env.local or CI secrets; do not commit credentials.
REQUIRE_MAC_SIGNING=false
ELECTRON_BUILDER_ALLOW_UNSIGNED_MAC=0
CSC_LINK=
CSC_KEY_PASSWORD=
MACOS_CERTIFICATE=
MACOS_CERTIFICATE_PASSWORD=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_ISSUER_ID=
